# Copy this file to .env.local and fill in real values there. Never commit .env.local.

# MongoDB Atlas connection string
# Example shape: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/resolx?retryWrites=true&w=majority
MONGODB_URI=

# Session secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# AUTH_SECRET=

# Students must register with an email whose domain matches this value
COLLEGE_EMAIL_DOMAIN=mnnit.ac.in

# Login session lifetime in hours (1-720)
SESSION_TTL_HOURS=12